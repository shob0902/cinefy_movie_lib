# ---------------------------------------------------------------------------
# TMDB credentials — get a free key at https://www.themoviedb.org/settings/api
# Provide EITHER the v4 read access token (preferred) OR the v3 API key.
# ---------------------------------------------------------------------------
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# SQLite file location (relative paths resolve from the server package root)
DATABASE_FILE=./data/cinefy.sqlite

# --- Outbound TMDB behaviour -------------------------------------------------
# Hard timeout for a single TMDB request, in ms
TMDB_TIMEOUT_MS=8000
# How many times a failed TMDB request is retried (exponential backoff + jitter)
TMDB_MAX_RETRIES=2
# Client-side throttle so we never trip TMDB's own rate limits
TMDB_RATE_LIMIT_PER_SEC=20
# Max concurrent in-flight TMDB requests
TMDB_MAX_CONCURRENCY=8

# --- Caching -----------------------------------------------------------------
# Entries kept in the hot in-memory tier before LRU eviction
CACHE_MAX_ENTRIES=1000
# Fresh-for windows, in seconds
CACHE_TTL_LIST_SEC=300
CACHE_TTL_DETAIL_SEC=3600
CACHE_TTL_GENRES_SEC=86400
CACHE_TTL_CONFIG_SEC=86400
# How long an expired entry is still kept around to be served if TMDB is down
CACHE_STALE_GRACE_SEC=86400

# --- Inbound protection ------------------------------------------------------
RATE_LIMIT_PER_MIN=240
